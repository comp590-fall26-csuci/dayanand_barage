[159.391375, "o", "\u001b[34m==>\u001b[0m \u001b[1mNew Formulae\u001b[0m\r\n"]
[159.391402, "o", "actions-languageserver: Language server for GitHub Actions YAML files\r\n"]
[159.391452, "o", "adrs: Architectural Decision Record tool in Rust\r\nadvai-cli: CLI for managing skills and external CLIs\r\nagent-manager: Terminal UI to manage AI coding-agent tmux sessions\r\nai-cli: Generate images, video, audio, and text from the terminal\r\namy: Nostr client from the Amethyst project\r\nansible@13: Automate deployment, configuration, and upgrading\r\napm: Dependency manager for AI agent configuration\r\nasar: SNES assembler for applying patches to ROM images or building ROMs\r\nasccli: App Store Connect CLI to manage apps, versions, and screenshots\r\n"]
[159.391493, "o", "atomgit-cli: Command-line interface for AtomGit\r\naube: Fast Node.js package manager\r\nauth0: Build, manage and test your Auth0 integrations from the command-line\r\navisynthplus: Improved version of the AviSynth frameserver\r\nawww: Answer to your Wayland Wallpaper Woes\r\nb4n: Terminal user interface (TUI) for Kubernetes API written in Rust\r\nbaguette: Headless iOS Simulator manager and host-side input injection for iOS 26\r\nbaml: Programming language for agents\r\nbashka: Static verification of installation bash scripts\r\nbashly: Bash command-line framework and CLI generator\r\nbbrew: TUI for managing Homebrew, Flatpak, and Mac App Store packages\r\nbeets: Music library manager and tagger\r\n"]
[159.39151, "o", "bend: Language that blocks AI mistakes via proof\r\nbetterglobekey: Reworked Globe key for faster input source switching\r\nbismark: Bisulfite read mapper and methylation caller\r\nbittensor: SDK and command-line tool for the Bittensor network\r\n"]
[159.391526, "o", "bluetuith: Cross-platform TUI bluetooth manager\r\nbomctl: Format-agnostic SBOM tooling for the stages between SBOM generation and analysis\r\nbracken: Bayesian estimation of species abundance from Kraken output\r\nbtdu: Sampling disk usage profiler for btrfs\r\nbttf: CLI tool for datetime arithmetic, parsing, formatting and more\r\n"]
