[491.357553, "o", "\u001b[?25l\u001b[20;163H~@k\u001b[19;48H"]
[491.357801, "o", "\u001b[20;163H   \u001b[19;35H\u001b[1;19r\u001b[19;1H\r\n\u001b[1;20r\u001b[19;5Hwith open(file_path, \"w\") as f:\b\u001b[?25h"]
[491.441829, "o", "\u001b[?25l\u001b[20;163H~@k\u001b[19;35H"]
