[479.654976, "o", "\u001b[?25l\u001b[mimport os\u001b[2;1H\u001b[K\u001b[3;1Hdef fib_recursive(n):\u001b[3;22H\u001b[K\u001b[4;1H    if n <= 0:\u001b[4;15H\u001b[K\u001b[5;1H        return 0\u001b[5;17H\u001b[K\u001b[6;1H    elif n == 1:\u001b[6;17H\u001b[K\u001b[7;1H        return 1\u001b[7;17H\u001b[K\u001b[8;1H    return fib_recursive(n - 1) + fib_recursive(n - 2)\u001b[8;55H\u001b[K\u001b[9;1H\u001b[K\u001b[10;1Hdef save_fibonacci_to_file(n, directory, filename):\u001b[10;52H\u001b[K\u001b[11;1H    # 1. Create the directory if it doesn't exist\u001b[11;50H\u001b[K\u001b[12;1H    if not os.path.exists(directory):\u001b[12;38H\u001b[K\u001b[13;1H        os.makedirs(directory)\u001b[13;31H\u001b[K\u001b[14;1H    \u001b[14;5H\u001b[K\u001b[15;1H    # 2. Define the full path\u001b[15;30H\u001b[K\u001b[16;1H    file_path = os.path.join(directory, filename)\u001b[16;50H\u001b[K\u001b[17;1H    \u001b[17;5H\u001b[K\u001b[18;1H    # 3. Generate the numbers recursively and store them in a list\u001b[18;67H\u001b[K\u001b[19;1H    fib_numbers = [fib_recursive(i) for i in range(n)]\u001b[19;55H\u001b[K\u001b[1;19r\u001b[1;1H\u001b[6M\u001b[1;20r\u001b[15;5H# 4. Reverse the list\r\n    fib_numbers.reverse()\u001b[18;5H# 5. Write the reversed sequence to the file\r\n    with open(file_path, \"w\") as\u001b[20;11H\u001b[1m(paste) --\u001b[19;33H\u001b[?25h"]
[479.662762, "o", "\u001b[?25l\u001b[1;19r\u001b[m\u001b[1;1H\u001b[7M\u001b[1;20r\u001b[12;34Hf:\u001b[13;9Hfor num in fib_numbers:\u001b[14;13Hf.write(f\"{num}\\n\")\u001b[16;5Hprint(f\"Success! {n} numbers written to {file_path} in reverse order.\")\r\n\r\n# Run:\r\nsave_fibonacci_to_file\u001b[46m(\u001b[m25, \"output\", \"fibonacci-25-rec.txt\"\u001b[46m)\u001b[m\u001b[20;11H\u001b[1m--a\u001b[m\u001b[20;13H\u001b[K\u001b[19;61H\u001b[?25h"]
