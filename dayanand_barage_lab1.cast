[257.891371, "o", "\u001b[?25l    # 1. Create the directory if it doesn't exist\r\n    if not os.path.exists(directory):\u001b[2;38H\u001b[K\u001b[3;1H        os.makedirs(directory)\u001b[3;31H\u001b[K\u001b[4;1H    \u001b[4;5H\u001b[K\u001b[5;1H    # 2. Define the full path\u001b[5;30H\u001b[K\u001b[6;1H    file_path = os.path.join(directory, filename)\u001b[6;50H\u001b[K\u001b[7;1H    \u001b[7;5H\u001b[K\u001b[8;1H    # 3. Generate and write the numbers\u001b[8;40H\u001b[K\u001b[9;1H    a, b = 0, 1\u001b[9;16H\u001b[K\u001b[10;1H    with open(file_path, \"w\") as f:\u001b[10;36H\u001b[K\u001b[11;1H        for i in range(n):\u001b[11;27H\u001b[K\u001b[12;1H            f.write(f\"{a}\\n\")\u001b[12;30H\u001b[K\u001b[13;1H            a, b = b, a + b\u001b[13;28H\u001b[K\u001b[14;1H            \u001b[14;13H\u001b[K\u001b[15;1H    print(f\"Success! {n} numbers written to {file_path}\")\u001b[15;58H\u001b[K\u001b[16;1H\u001b[K\u001b[17;1H# Run:\u001b[17;7H\u001b[K\u001b[18;1Hsave_fibonacci_to_file(25, \"output\", \"fibonacci-25.txt\")\u001b[18;57H\u001b[K\u001b[19;1H\u001b[K\u001b[19;1H\u001b[?25h"]
