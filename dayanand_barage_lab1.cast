[409.161518, "o", "\u001b[33mcommit a48e4b06bf7f4670cb4e38023bf461d658d7eaba\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m\u001b[33m -> \u001b[m\u001b[1;32mlab1\u001b[m\u001b[33m)\u001b[m\u001b[m\r\nAuthor: Dayanand Barage <dayanand.barage934@myci.csuci.edu>\u001b[m\r\nDate:   Sun Sep 6 11:44:22 2026 -0700\u001b[m\r\n\u001b[m\r\n    Adding lab1.py, output directory, no files from the output directory but the .gitignore file\u001b[m\r\n\u001b[m\r\n\u001b[33mcommit fd0cefd3bf338cacc6bacd9415efa32ab212a99b\u001b[m\u001b[33m (\u001b[m\u001b[1;32mmain\u001b[m\u001b[33m)\u001b[m\u001b[m\r\nAuthor: Dayanand Barage <dayanand.barage934@myci.csuci.edu>\u001b[m\r\nDate:   Sun Sep 6 11:39:32 2026 -0700\u001b[m\r\n\u001b[m\r\n    First Commit\u001b[m\r\n\r\u001b[K\u001b[?1l\u001b>"]
