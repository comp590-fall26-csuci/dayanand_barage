[431.278468, "o", "\u001b[?1049h\u001b[>4;2m\u001b[?1h\u001b=\u001b[?2004h\u001b[?1004h\u001b[1;20r\u001b[?12h\u001b[?12l\u001b[22;2t\u001b[22;1t"]
[431.279438, "o", "\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[20;1H\"lab1.py\""]
[431.279596, "o", " 22L, 586B"]
[431.279672, "o", "\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H"]
[431.279701, "o", "\u001b[>c\u001b]11;?\u0007\u001b]10;?\u0007"]
[431.279907, "o", "\u001b[1;1Himport os\u001b[2;1H\u001b[K\u001b[3;1Hdef save_fibonacci_to_file(n, directory, filename):\u001b[3;52H\u001b[K\u001b[4;5H# 1. Create the directory if it doesn't exist\r\n    if not os.path.exists(directory):\u001b[6;9Hos.makedirs(directory)\u001b[8;5H# 2. Define the full path\r\n    file_path = os.path.join(directory, filename)\u001b[11;5H# 3. Generate and write the numbers\r\n    a, b = 0, 1\r\n    with open(file_path, \"w\") as f:\u001b[14;9Hfor i in range(n):\u001b[15;13Hf.write(f\"{a}\\n\")\u001b[16;13Ha, b = b, a + b\u001b[18;5Hprint(f\"Success! {n} numbers written to {file_path}\")\u001b[1;1H\u001b[?25h\u001b[?4m"]
[431.285019, "o", "\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\u001bP+q6b31\u001b\\\u001b[?12$p"]
[431.285258, "o", "\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[1;1Himport os\r\n\r\ndef save_fibonacci_to_file(n, directory, filename):\r\n    # 1. Create the directory if it doesn't exist\r\n    if not os.path.exists(directory):\u001b[6;9Hos.makedirs(directory)\u001b[8;5H# 2. Define the full path\r\n    file_path = os.path.join(directory, filename)\u001b[11;5H# 3. Generate and write the numbers\r\n    a, b = 0, 1\r\n    with open(file_path, \"w\") as f:\u001b[14;9Hfor i in range(n):\u001b[15;13Hf.write(f\"{a}\\n\")\u001b[16;13Ha, b = b, a + b\u001b[18;5Hprint(f\"Success! {n} numbers written to {file_path}\")\r\n\r\n\"lab1.py\" 22L, 586B\u001b[1;1H\u001b[?25h"]
[433.310575, "o", "\u001b[?25l\u001b[20;163Hd\u001b[1;1H"]
[433.310776, "o", "\u001b[?25h"]
[433.495576, "o", "\u001b[?25l\u001b[20;164Hd\u001b[1;1H"]
