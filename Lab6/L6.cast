[2627.599962, "o", "- name: Lab 6 Playbook\r\n  hosts: test\r\n  become: true\r\n\r\n  tasks:\r\n  - name: Install asciinema\r\n      apt:\r\n        name: asciinema\r\n        state: present\r\n        update_cache: yes\r\n  - name: Install apache2\r\n      apt:\r\n        name: apache2\r\n        state: present\r\n        update_cache: yes\r\n  - name: Start and Enable apache service \r\n      service:\r\n        name: apache2\r\n        state: started\r\n        enabled: yes\r\n  - name: Debug Message \r\n      debug:\r\n        msg: \"Hostname for {{ inventory_hostname }} is {{ ansible_hostname }}\"\r\n      when: ansible_hostname is defined\r\n\r\n\r\n\r\n"]
