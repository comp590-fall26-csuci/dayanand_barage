[2953.944401, "o", "\u001b[7m- name: Lab 6 Playbook\u001b[27m\r\n\r\u001b[7m  hosts: test\u001b[27m\r\n\r\u001b[7m  become: true\u001b[27m\r\n\r\n\r\u001b[7m  tasks:\u001b[27m\r\n\r\u001b[7m    - name: Install asciinema\u001b[27m\r\n\r\u001b[7m      apt:\u001b[27m\r\n\r\u001b[7m        name: asciinema\u001b[27m\r\n\r\u001b[7m        state: present\u001b[27m\r\n\r\u001b[7m        update_cache: yes\u001b[27m\r\n\r\n\r\u001b[7m    - name: Install apache2\u001b[27m\r\n\r\u001b[7m      apt:\u001b[27m\r\n\r\u001b[7m        name: apache2\u001b[27m\r\n\r\u001b[7m        state: present\u001b[27m\r\n\r\u001b[7m        update_cache: yes\u001b[27m\r\n\r\n\r\u001b[7m    - name: Start and Enable apache service \u001b[27m\r\n"]
[2953.944515, "o", "\r\u001b[7m      service:\u001b[27m\r\n\r\u001b[7m        name: apache2\u001b[27m\r\n\r\u001b[7m        state: started\u001b[27m\r\n\r\u001b[7m        enabled: yes\u001b[27m\r\n\r\n\r\u001b[7m    - name: Debug Message \u001b[27m\r\n\r\u001b[7m      debug:\u001b[27m\r\n\r\u001b[7m        msg: \"Hostname for {{ inventory_hostname }} is {{ ansible_hostname }}\"\u001b[27m\r\n\r\u001b[7m      when: ansible_hostname is defined\u001b[27m\r\n\r"]
[2957.069107, "o", "\u0007\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C- name: Lab 6 Playbook\r\n\r  hosts: test\r\n\r  become: true\r\n\r\n\r  tasks:\r\n\r    - name: Install asciinema\r\n\r      apt:\r\n\r        name: asciinema\r\n\r        state: present\r\n\r        update_cache: yes\r\n\r\n\r    - name: Install apache2\r\n\r      apt:\r\n\r        name: apache2\r\n\r        state: present\r\n\r        update_cache: yes\r\n\r\n\r    - name: Start and Enable apache service \r\n\r      service:\r\n\r        name: apache2\r\n\r        state: started\r\n\r        enabled: yes\r\n\r\n\r    - name: Debug Message \r\n\r      debug:\r\n\r        msg: \"Hostname for {{ inventory_hostname }} is {{ ansible_hostname }}\"\r\n\r      when: ansible_hostname is defined\r\n\r"]
